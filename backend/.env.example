# Help Radius Backend Environment Configuration
PORT=5000
NODE_ENV=development

# Authentication & Security
# Generate with: node -e "console.log(require('crypto').randomBytes(48).toString('hex'))"
JWT_SECRET=your_minimum_32_character_random_hex_secret_here
JWT_EXPIRES_IN=7d

# CORS Allowed Origins (comma-separated)
CLIENT_ORIGINS=http://localhost:5173,http://localhost:8080,http://127.0.0.1:5173

# Initial Administrator Seed (only used if no admin exists in database)
ADMIN_EMAIL=admin@helpradius.org
ADMIN_PASSWORD=SetAStrongAdminPasswordHere123!

# Services
SMS_PROVIDER=simulated
